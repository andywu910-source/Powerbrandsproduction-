# PowerBrands Productions - example environment. Placeholders only; real values live in
# /var/www/powerbrandsproductions/.env on the server and are never committed.
APP_NAME="PowerBrands Productions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_db_user
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- PBP settings (see config/pbp.php) ---
PBP_ADMIN_EMAIL=admin@example.com
PBP_ADMIN_NAME="Admin Name"
# bcrypt hash of the first admin's initial password (used once by `php artisan pbp:create-admin`)
PBP_ADMIN_INITIAL_PASSWORD_HASH=
PBP_GOOGLE_ALLOWED_DOMAIN=example.com
PBP_SITE_TIMEZONE=America/New_York
PBP_MODULES=production,receiving,checklists,batchlog,labels,schedule,compliance
PBP_MODULES_OFF=
PBP_QC_RELEASE_STEP=false
PBP_SCHEDULE_EDITORS="role:admin"
PBP_SCHEDULE_SHOW_LABOR=false
PBP_SCHEDULE_DEFAULT_RATE=20
PBP_COMPLIANCE_EXCLUDED=

# Optional Google Drive/Sheets filing (leave off unless configured)
PBP_DRIVE_ENABLED=false
PBP_DRIVE_DRIVER=
PBP_DRIVE_FOLDER_ID=
# path to a service-account JSON file kept OUTSIDE the repo
PBP_DRIVE_CREDENTIALS=

# --- Weekly Bookkeeping (admin-only module) ---
# Off until "bookkeeping" is added to PBP_MODULES above. Turn it off again with
# PBP_MODULES_OFF=bookkeeping. It is not forced on by a release.
# Real values belong only in the server .env. Never commit a key or token.
DISTRU_API_KEY=
# DISTRU_API_BASE=https://app.distru.com/public/v1
# HTML signature used until an admin saves one on the bookkeeping page.
BOOKKEEPING_SIGNATURE_HTML=
# Mail stays off until TRANSPORT is smtp or gmail and the matching credentials are set.
# Messages are sent from billing@powerbrandsny.com. For Gmail, that address must be
# the account (or a send-as alias) the refresh token belongs to.
BOOKKEEPING_MAIL_TRANSPORT=
BOOKKEEPING_MAIL_FROM_ADDRESS=billing@powerbrandsny.com
BOOKKEEPING_MAIL_FROM_NAME=Powerbrands
BOOKKEEPING_SMTP_HOST=
BOOKKEEPING_SMTP_PORT=587
BOOKKEEPING_SMTP_USERNAME=
BOOKKEEPING_SMTP_PASSWORD=
BOOKKEEPING_SMTP_ENCRYPTION=tls
BOOKKEEPING_GMAIL_CLIENT_ID=
BOOKKEEPING_GMAIL_CLIENT_SECRET=
BOOKKEEPING_GMAIL_REFRESH_TOKEN=
